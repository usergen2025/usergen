# Production Environment Configuration
# This file contains all environment variables for production environment

# Environment
NODE_ENV=production
LOG_LEVEL=warn

# Service Ports
AUTH_SERVICE_PORT=3000
AI_CONTENT_SERVICE_PORT=3001
VOICE_AUDIO_SERVICE_PORT=3002
MEDIA_MANAGEMENT_SERVICE_PORT=3003
VIDEO_PROCESSING_SERVICE_PORT=3004
PAYMENT_WALLET_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
PROJECT_MANAGEMENT_SERVICE_PORT=3007
ANALYTICS_SERVICE_PORT=3008
API_GATEWAY_PORT=8000

# Database URLs - Production Environment
DATABASE_URL_AUTH=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_auth
DATABASE_URL_AI_CONTENT=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_ai_content
DATABASE_URL_VOICE_AUDIO=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_voice_audio
DATABASE_URL_MEDIA_MANAGEMENT=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_media_management
DATABASE_URL_VIDEO_PROCESSING=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_video_processing
DATABASE_URL_PAYMENT_WALLET=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_payment_wallet
DATABASE_URL_NOTIFICATION=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_notification
DATABASE_URL_PROJECT_MANAGEMENT=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_project_management
DATABASE_URL_ANALYTICS=postgresql://prod_user:${PROD_DB_PASSWORD}@prod-db-cluster:5432/usergen_analytics

# Redis Configuration
REDIS_URL=redis://prod-redis-cluster:6379

# MongoDB Configuration
MONGODB_URL=mongodb://prod-mongo-cluster:27017/usergen_metadata

# Message Queue Configuration
RABBITMQ_URL=amqp://prod_user:${PROD_RABBITMQ_PASSWORD}@prod-rabbitmq-cluster:5672

# JWT Configuration
JWT_SECRET=SFVBJIK@67289416VYUQVDUQVCHU=BCHUDB567UJCNUEHJB.
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=NBCYRU78OTUIGHKL/OLR7IY:EUTDSHFXGCVB.HOPYIOTULFVK.
JWT_REFRESH_EXPIRES_IN=7d

# File Storage - Production Environment
STORAGE_TYPE=s3
AWS_S3_BUCKET=usergen-prod-media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${PROD_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${PROD_AWS_SECRET_ACCESS_KEY}
CDN_URL=https://cdn.usergen.ai

# AI Service API Keys - Production Keys
OPENAI_API_KEY=${PROD_OPENAI_API_KEY}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_GPT4=gpt-4
OPENAI_MODEL_GPT35=gpt-3.5-turbo
OPENAI_MODEL_DALLE3=dall-e-3
OPENAI_MODEL_DALLE2=dall-e-2

ELEVENLABS_API_KEY=${PROD_ELEVENLABS_API_KEY}
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

RUNWAY_API_KEY=${PROD_RUNWAY_API_KEY}
RUNWAY_BASE_URL=https://api.runwayml.com/v1

MIDJOURNEY_API_KEY=${PROD_MIDJOURNEY_API_KEY}
MIDJOURNEY_BASE_URL=https://api.midjourney.com/v1

# Payment Processing - Production Keys
STRIPE_SECRET_KEY=${PROD_STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${PROD_STRIPE_WEBHOOK_SECRET}
RAZORPAY_KEY_ID=${PROD_RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${PROD_RAZORPAY_KEY_SECRET}

# Email Service - Production Keys
SENDGRID_API_KEY=${PROD_SENDGRID_API_KEY}
FROM_EMAIL=noreply@usergen.ai
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=${PROD_SENDGRID_API_KEY}

# OAuth: public origin of auth API (redirects use /api/auth/google/callback)
BASE_URL=${PROD_AUTH_PUBLIC_BASE_URL}

# Social Login Configuration
GOOGLE_CLIENT_ID=${PROD_GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${PROD_GOOGLE_CLIENT_SECRET}
FACEBOOK_APP_ID=${PROD_FACEBOOK_APP_ID}
FACEBOOK_APP_SECRET=${PROD_FACEBOOK_APP_SECRET}

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000

# CORS Configuration
CORS_ORIGINS=https://usergen.ai,https://admin.usergen.ai

# Service Discovery
SERVICE_DISCOVERY_URL=http://prod-consul-cluster:8500
CONSUL_HOST=prod-consul-cluster
CONSUL_PORT=8500

# File Upload Limits
MAX_FILE_SIZE=200MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/avi,video/mov,audio/mp3,audio/wav,audio/m4a

# Monitoring - Full monitoring enabled for production
ENABLE_PROMETHEUS=true
ENABLE_ELK=true
ENABLE_JAEGER=true
ENABLE_GRAFANA=true
PROMETHEUS_PORT=9090

# AI Service Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# Frontend URL
FRONTEND_URL=https://usergen.ai
BASE_URL=https://api.usergen.ai

# Swagger Configuration
ENABLE_SWAGGER=false
SWAGGER_USE_BASIC_AUTH=true
SWAGGER_USER=${PROD_SWAGGER_USER}
SWAGGER_PASSWORD=${PROD_SWAGGER_PASSWORD}

# Swagger Aggregator Service
SWAGGER_AGGREGATOR_PORT=9090
