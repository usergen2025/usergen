FACEBOOK_APP_SECRET=dev-facebook-app-secret

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=200

# CORS Configuration
