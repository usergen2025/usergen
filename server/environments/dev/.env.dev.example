# Service Discovery
SERVICE_DISCOVERY_URL=http://dev-consul-server:8500
CONSUL_HOST=dev-consul-server
CONSUL_PORT=8500

# File Upload Limits
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/avi,video/mov,audio/mp3,audio/wav,audio/m4a

# Monitoring - Optional (Enabled for dev)
ENABLE_PROMETHEUS=true
ENABLE_ELK=false
ENABLE_JAEGER=false
ENABLE_GRAFANA=true
PROMETHEUS_PORT=9090

# AI Service Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# Frontend URL
FRONTEND_URL=https://dev.usergen.ai
BASE_URL=https://dev-api.usergen.ai

# Swagger Configuration
ENABLE_SWAGGER=true
SWAGGER_USE_BASIC_AUTH=true
SWAGGER_USER=dev_admin
SWAGGER_PASSWORD=secure_dev_password

# Swagger Aggregator Service
SWAGGER_AGGREGATOR_PORT=9090
