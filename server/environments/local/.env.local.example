# OAuth (auth-service): BASE_URL origin; Google redirect URI = {BASE_URL}/api/auth/google/callback (auto /api)
BASE_URL=http://localhost:9000

# Social Login Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Service Discovery
SERVICE_DISCOVERY_URL=http://localhost:8500
CONSUL_HOST=localhost
CONSUL_PORT=8500

# File Upload Limits
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/avi,video/mov,audio/mp3,audio/wav,audio/m4a

# Monitoring - Optional (Disabled by default for local)
ENABLE_PROMETHEUS=false
ENABLE_ELK=false
ENABLE_JAEGER=false
ENABLE_GRAFANA=false
PROMETHEUS_PORT=9090

# AI Service Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# Frontend URL (Next.js default dev port)
FRONTEND_URL=http://localhost:3200
BASE_URL=http://localhost:8000

# Microservice URLs (browser or gateway; align with client NEXT_PUBLIC_*)
PAYMENT_SERVICE_URL=http://localhost:9005/api
IAM_SERVICE_URL=http://localhost:9010/api
CAMPAIGN_SERVICE_URL=http://localhost:9011/api
NOTIFICATION_SERVICE_URL=http://localhost:9006/api

# Same value on notification-service, campaign-service, video-processing-service for internal routes
INTERNAL_NOTIFICATION_SECRET=

# Swagger Configuration
ENABLE_SWAGGER=true
SWAGGER_USE_BASIC_AUTH=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123

# Swagger Aggregator Service
SWAGGER_AGGREGATOR_PORT=9090
