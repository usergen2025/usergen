// Prisma schema for Payment Wallet Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserCredits {
  id            String    @id @default(cuid())
  userId        String    @unique
  credits       Int       @default(100)
  updatedAt     DateTime  @updatedAt

  @@map("user_credits")
  @@index([userId])
}

model WorkspaceCredits {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  credits       Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@map("workspace_credits")
  @@index([workspaceId])
}

model Transaction {
  id            String              @id @default(cuid())
  type          TransactionType
  amount        Int
  contextType   ContextType
  
  userId        String?
  workspaceId   String?
  actorUserId   String?
  activityName  String?
  resourceId    String?
  
  status        TransactionStatus   @default(COMPLETED)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  creditLedgers CreditLedger[]

  @@map("transactions")
  @@index([userId])
  @@index([workspaceId])
  @@index([actorUserId])
  @@index([contextType])
  @@index([type])
  @@index([createdAt])
}

model CreditLedger {
  id            String    @id @default(cuid())
  entityType    EntityType
  entityId      String
  transactionId String
  balanceBefore Int
  balanceAfter  Int
  change        Int
  description   String
  createdAt     DateTime  @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("credit_ledger")
  @@index([entityType, entityId])
  @@index([transactionId])
  @@index([createdAt])
}

enum TransactionType {
  EARNED
  SPENT
  PURCHASED
  REFUNDED
  TRANSFER
}

enum ContextType {
  INDIVIDUAL
  TEAM
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EntityType {
  USER
  WORKSPACE
}

// ==================== Pricing Configuration ====================

// Dynamic pricing configuration (admin-managed)
model OperationPricing {
  id            String   @id @default(cuid())
  operationType String   @unique // "SCRIPT_GENERATION", "IMAGE_GENERATION", etc.
  displayName   String
  description   String?
  creditCost    Int      // Cost in credits (1 credit = 1 rupee)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?  // Admin user ID who last updated
  
  pricingHistory PricingHistory[]

  @@map("operation_pricing")
  @@index([operationType])
  @@index([isActive])
}

// Track pricing changes over time for audit
model PricingHistory {
  id                 String   @id @default(cuid())
  operationPricingId String
  previousCost       Int
  newCost            Int
  changedBy          String   // Admin user ID
  reason             String?
  createdAt          DateTime @default(now())
  
  operationPricing   OperationPricing @relation(fields: [operationPricingId], references: [id], onDelete: Cascade)

  @@map("pricing_history")
  @@index([operationPricingId])
  @@index([createdAt])
}

// Snapshot of costs at time of generation (preserves historical pricing)
model GenerationCostSnapshot {
  id               String    @id @default(cuid())
  projectId        String
  userId           String
  sceneNumber      Int?
  operationType    String    // "SCRIPT_GENERATION", "IMAGE_GENERATION", etc.
  operationName    String    // Human-readable name
  creditCost       Int       // Cost AT TIME OF GENERATION
  metadata         Json?     // Additional details (retry count, duration, provider, etc.)
  createdAt        DateTime  @default(now())
  walletSettledAt  DateTime? // Set when included in a wallet settlement (deferred billing)

  @@map("generation_cost_snapshots")
  @@index([projectId])
  @@index([userId])
  @@index([operationType])
  @@index([createdAt])
}

// Operation types enum for type safety
enum OperationType {
  SCRIPT_GENERATION
  SCENE_REGENERATION
  AUDIO_GENERATION
  IMAGE_GENERATION
  VIDEO_GENERATION
  AVATAR_VIDEO
  STOCK_FOOTAGE
  FINAL_RENDER
  WATERMARK_REMOVAL
}

