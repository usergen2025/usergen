# Environment Configuration for Auth Service
NODE_ENV=local
SERVICE_NAME=auth-service
SERVICE_PORT=9000
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_auth

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=SFVBJIK@67289416VYUQVDUQVCHU=BCHUDB567UJCNUEHJB.
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=NBCYRU78OTUIGHKL/OLR7IY:EUTDSHFXGCVB.HOPYIOTULFVK.
JWT_REFRESH_EXPIRES_IN=7d

# Message Queue Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Public URL for OAuth callbacks (Google / Facebook) ---
# Nest serves auth under global prefix "api", so redirect URIs are:
#   {BASE_URL normalized with /api}/auth/google/callback
# Example local:  http://localhost:9000/api/auth/google/callback
# Example prod:    https://api.example.com/api/auth/google/callback
#
# Set BASE_URL to the origin of the auth service (no trailing slash). May be host:port only;
# /api is appended automatically if missing.
# Optional: set OAUTH_PUBLIC_BASE_URL instead to override only OAuth (same rules).
BASE_URL=http://localhost:9000
# OAUTH_PUBLIC_BASE_URL=

# Social Login — create OAuth 2.0 Client IDs in Google Cloud Console (APIs & Services > Credentials),
# configure the OAuth consent screen, then paste Client ID and Client secret below.
# Authorized redirect URI must exactly match: {see BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Email Configuration (Notification Service URL)
NOTIFICATION_SERVICE_URL=http://localhost:9006/api

# Payment / wallet (admin credit updates sync wallet balance here)
PAYMENT_SERVICE_URL=http://localhost:9005/api

# OAuth / magic-link redirect base (Next.js app URL, no trailing slash)
FRONTEND_URL=http://localhost:3200

# Legacy Email Configuration (if needed)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@usergen.ai
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=10

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:9000

# Monitoring Configuration
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
