NODE_ENV=local
SERVICE_NAME=media-management-service
SERVICE_PORT=9009
CORS_ORIGINS=http://localhost:3200,http://localhost:9000
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# GCS (Google Cloud Storage) Configuration
# Enable GCS for public URL generation
GCS_ENABLED=false
GCS_BUCKET_NAME=usergen-storage
GCS_PROJECT_ID=your-gcp-project-id
# Path to service account credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# OR use base64-encoded credentials (for containerized deployments)
# GCS_CREDENTIALS_JSON_BASE64=eyJ...

# Magnific Music API (stock background music — header x-magnific-api-key)
# https://docs.magnific.com/api-reference/music/search-music
MAGNIFIC_API_KEY=
MAGNIFIC_API_BASE_URL=https://api.magnific.com

