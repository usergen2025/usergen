datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ClonedVoice {
  id           String   @id @default(cuid())
  elevenlabsId String   @unique
  userId       String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([elevenlabsId])
}
