NODE_ENV=local
SERVICE_NAME=voice-audio-service
SERVICE_PORT=9002
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:9000

# AI Service API Keys
ELEVENLABS_API_KEY=sk_6322652978d02b4b05900813f5bcfb58509dcf98d20615c8

# Database (if needed)
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_voice_audio

# Redis
REDIS_URL=redis://localhost:6379

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# GCS (Google Cloud Storage) Configuration
# Enable GCS for public URL generation
GCS_ENABLED=false
GCS_BUCKET_NAME=usergen-storage
GCS_PROJECT_ID=your-gcp-project-id
#
# Authentication Options (in order of preference):
# 1. ADC (Application Default Credentials) - RECOMMENDED
#    - For local dev: Run "gcloud auth application-default login"
#    - For GCP environments: Works automatically
#    - Leave GOOGLE_APPLICATION_CREDENTIALS and GCS_CREDENTIALS_JSON_BASE64 unset
#
# 2. Service Account Key File (if ADC not available):
#    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# 3. Base64-encoded credentials (for containerized deployments):
#    GCS_CREDENTIALS_JSON_BASE64=eyJ...

# FFmpeg Resource Limits (to prevent false crypto-mining detection)
# Maximum number of CPU threads FFmpeg can use (default: 4, recommended: 2-4)
FFMPEG_MAX_THREADS=4
# Process priority using nice (0-19, higher = lower priority, default: 10)
FFMPEG_NICE_PRIORITY=10
# Timeout for FFmpeg operations in milliseconds (default: 1800000 = 30 minutes)
FFMPEG_TIMEOUT_MS=1800000
# Enable nice for process priority management (default: true)
FFMPEG_USE_NICE=true
# Enable ionice for I/O priority management (default: true)
FFMPEG_USE_IONICE=true

