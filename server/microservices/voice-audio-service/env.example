NODE_ENV=local
SERVICE_NAME=voice-audio-service
SERVICE_PORT=9002
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:9000

# AI Service API Keys
ELEVENLABS_API_KEY=sk_6322652978d02b4b05900813f5bcfb58509dcf98d20615c8

# Database (if needed)
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_voice_audio

# Redis
REDIS_URL=redis://localhost:6379

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# GCS (Google Cloud Storage) Configuration
# Enable GCS for public URL generation
GCS_ENABLED=false
GCS_BUCKET_NAME=usergen-storage
GCS_PROJECT_ID=your-gcp-project-id
#
# Authentication Options (in order of preference):
# 1. ADC (Application Default Credentials) - RECOMMENDED
#    - For local dev: Run "gcloud auth application-default login"
#    - For GCP environments: Works automatically
#    - Leave GOOGLE_APPLICATION_CREDENTIALS and GCS_CREDENTIALS_JSON_BASE64 unset
#
# 2. Service Account Key File (if ADC not available):
#    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# 3. Base64-encoded credentials (for containerized deployments):
#    GCS_CREDENTIALS_JSON_BASE64=eyJ...

