NODE_ENV=local
SERVICE_NAME=video-processing-service
SERVICE_PORT=9004
CORS_ORIGINS=http://localhost:3200,http://localhost:9000
RUNWAY_API_KEY=your-runway-api-key
PIKA_API_KEY=your-pika-api-key

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_video
# Or use DATABASE_URL_VIDEO for service-specific naming
DATABASE_URL_VIDEO=postgresql://postgres:password@localhost:5432/usergen_video

# JWT Configuration (required for authentication)
JWT_SECRET=SFVBJIK@67289416VYUQVDUQVCHU=BCHUDB567UJCNUEHJB.

# BytePlus Configuration (for image and video generation)
BYTEPLUS_API_KEY=db6f2ded-8ed9-430a-994d-422295c4905d
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# FAL Configuration (for image generation - alternative provider)
FAL_KEY=b77f1f84-484e-44c1-9f32-757d5dc86dd1:4e31b564c7d65c43af29f4ce73d4a27e
# FAL Storage URL (for file uploads in local environment - optional, has default)
# FAL_STORAGE_URL=https://fal.run/storage/upload

# HeyGen Configuration (for avatar videos - already configured in ai-content-service)
HEYGEN_API_KEY=sk_V2_hgu_k6DttD76w1e_AacvV2PfTOzCaxk1morlTbR2FX5YvmQp
# Avatar IV pipeline: legacy_av4 (POST /v2/video/av4/generate + image_key) or v3_photo_avatar (POST /v3/assets → /v3/avatars → /v3/videos)
# Stitched MP3: uploadAudio asset id → legacy AV4 audio_asset_id; v3 POST /v3/videos sends the same id as audio_asset_id (omit script/voice_id). TTS-only v3 uses script + voice_id.
HEYGEN_AVATAR_PIPELINE=legacy_av4
# Optional: default HeyGen TTS voice id when project.voiceId is missing (v3 TTS path only — omit when audio_asset_id is used)
# HEYGEN_DEFAULT_VOICE_ID=

# Project logging (local files + batched GCS) — see ProjectLogService
LOG_DIR=./logs
LOG_GCS_SYNC_INTERVAL_MS=300000
# LOG_GCS_PREFIX=project-logs
# Elasticsearch/Kibana: not used in v1; logs may be shipped later from these files or stdout.

# Voice Audio Service URL
VOICE_AUDIO_SERVICE_URL=http://localhost:9002/api

# Media management (stock search/download — must match media-management-service port, default 9009)
MEDIA_MANAGEMENT_SERVICE_URL=http://localhost:9009/api

# Background music mix on final export (set to false to skip FFmpeg BGM mux)
BACKGROUND_MUSIC_ENABLED=true

# AI Content Service URL (for fetching avatar details)
AI_CONTENT_SERVICE_URL=http://localhost:9001

# Payment wallet service (credit deduction on completed final render)
PAYMENT_SERVICE_URL=http://localhost:9005

# Notification service — in-app bell + internal video pipeline notification API
NOTIFICATION_SERVICE_URL=http://localhost:9006/api
INTERNAL_NOTIFICATION_SECRET=

# Uploads directory
UPLOADS_DIR=./uploads
# Max width for watermarked preview playback (default 720)
PREVIEW_MAX_WIDTH=720

# Optional: TTF/OTF directory for FFmpeg libass caption burn-in (Inter, etc.). If unset, uses ./assets/fonts when present.
# When no fontsdir, web font family names (e.g. Inter) are mapped to Arial for reliable glyphs.
# CAPTION_FONTS_DIR=/absolute/path/to/fonts
# Caption renderer mode: html_css (default) or ass (legacy libass burn-in)
CAPTION_RENDERER_MODE=html_css
# FPS used for HTML/CSS caption layer generation (higher = smoother, slower renders)
CAPTION_LAYER_FPS=12
# When HTML captions fail: allow (ASS fallback) or deny (fail render). Use deny in prod once stable.
CAPTION_ASS_FALLBACK=allow
# Legacy VP9 WebM intermediate for captions — not recommended (macOS alpha issues). Default off.
# CAPTION_USE_VP9_INTERMEDIATE=false
# Playwright / Chromium (required for html_css on Linux VM):
#   npx playwright install chromium
#   sudo npx playwright install-deps chromium
# See docs/CAPTION_RENDERING.md for diagnosis playbook.

# Backend Base URL (for public file URLs in dev/prod environments)
# For local environment, this defaults to http://localhost:{SERVICE_PORT}
# For dev/prod, set this to your actual backend URL (e.g., http://your-vm-ip:9004 or https://your-domain.com)
BACKEND_BASE_URL=http://localhost:9004

# Redis Configuration (for queue system)
REDIS_URL=redis://localhost:6379

# Queue Configuration
QUEUE_CONCURRENCY_PER_USER=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=50

# GCS (Google Cloud Storage) Configuration
# Enable GCS for public URL generation (replaces FAL storage)
GCS_ENABLED=false
GCS_BUCKET_NAME=usergen-storage
GCS_PROJECT_ID=your-gcp-project-id
#
# Authentication Options (in order of preference):
# 1. ADC (Application Default Credentials) - RECOMMENDED
#    - For local dev: Run "gcloud auth application-default login"
#    - For GCP environments: Works automatically
#    - Leave GOOGLE_APPLICATION_CREDENTIALS and GCS_CREDENTIALS_JSON_BASE64 unset
#
# 2. Service Account Key File (if ADC not available):
#    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# 3. Base64-encoded credentials (for containerized deployments):
#    GCS_CREDENTIALS_JSON_BASE64=eyJ...

