# Swagger Aggregator Service Environment Configuration
NODE_ENV=local
SERVICE_NAME=swagger-aggregator-service
SWAGGER_AGGREGATOR_SERVICE_PORT=9090
SERVICE_PORT=9090
LOG_LEVEL=debug

# Service URLs for Swagger JSON fetching
AUTH_SERVICE_URL=http://localhost:9000
AI_CONTENT_SERVICE_URL=http://localhost:9001
VOICE_AUDIO_SERVICE_URL=http://localhost:9002
ACTIVITY_SERVICE_URL=http://localhost:9003
VIDEO_PROCESSING_SERVICE_URL=http://localhost:9004
PAYMENT_WALLET_SERVICE_URL=http://localhost:9005
NOTIFICATION_SERVICE_URL=http://localhost:9006
WORKSPACE_SERVICE_URL=http://localhost:9007
ANALYTICS_SERVICE_URL=http://localhost:9008
MEDIA_MANAGEMENT_SERVICE_URL=http://localhost:9009
IAM_SERVICE_URL=http://localhost:9010
CAMPAIGN_SERVICE_URL=http://localhost:9011

# Swagger JSON endpoints (relative paths)
SWAGGER_JSON_PATH=/api/docs-json

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:8080,http://localhost:9000

# Enable/Disable Swagger
ENABLE_SWAGGER=true

