# Swagger Aggregator Service Environment Configuration
NODE_ENV=local
SERVICE_NAME=swagger-aggregator-service
SWAGGER_AGGREGATOR_SERVICE_PORT=9090
SERVICE_PORT=9090
LOG_LEVEL=debug

# Service base URLs for Swagger JSON (/api/docs-json is appended). Use .../api to match other microservice env examples.
AUTH_SERVICE_URL=http://localhost:9000/api
AI_CONTENT_SERVICE_URL=http://localhost:9001/api
VOICE_AUDIO_SERVICE_URL=http://localhost:9002/api
ACTIVITY_SERVICE_URL=http://localhost:9003/api
VIDEO_PROCESSING_SERVICE_URL=http://localhost:9004/api
PAYMENT_WALLET_SERVICE_URL=http://localhost:9005/api
NOTIFICATION_SERVICE_URL=http://localhost:9006/api
WORKSPACE_SERVICE_URL=http://localhost:9007/api
ANALYTICS_SERVICE_URL=http://localhost:9008/api
MEDIA_MANAGEMENT_SERVICE_URL=http://localhost:9009/api
IAM_SERVICE_URL=http://localhost:9010/api
CAMPAIGN_SERVICE_URL=http://localhost:9011/api

# Swagger JSON endpoints (relative paths)
SWAGGER_JSON_PATH=/api/docs-json

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:8080,http://localhost:9000

# Enable/Disable Swagger
ENABLE_SWAGGER=true

