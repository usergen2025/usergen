NODE_ENV=local
SERVICE_NAME=campaign-service
SERVICE_PORT=9011
# Base URL used in returned asset links (no trailing slash). Defaults to http://localhost:SERVICE_PORT
PUBLIC_ASSET_BASE_URL=http://localhost:9011
CORS_ORIGINS=http://localhost:3200,http://localhost:9000

# Keep .env changes in this example file. Do not commit local .env values.
# DATABASE_URL reserved for upcoming persistence migration.
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_campaigns
JWT_SECRET=SFVBJIK@67289416VYUQVDUQVCHU=BCHUDB567UJCNUEHJB.
JWT_EXPIRES_IN=1h
PAYMENT_SERVICE_URL=http://localhost:9005/api
# Video-processing service (Nest global prefix is /api). Host-only URLs get /api appended automatically.
VIDEO_PROCESSING_SERVICE_URL=http://localhost:9004/api
# Notification service (in-app bell + transactional email). Use .../api suffix.
NOTIFICATION_SERVICE_URL=http://localhost:9006/api
# Same value as notification-service INTERNAL_NOTIFICATION_SECRET when set
INTERNAL_NOTIFICATION_SECRET=
WALLET_SYNC_AUTO_RETRY_ENABLED=true
WALLET_SYNC_AUTO_RETRY_INTERVAL_MS=60000
WALLET_SYNC_AUTO_RETRY_BATCH_SIZE=25
WALLET_SYNC_AUTO_RETRY_COOLDOWN_SECONDS=120
