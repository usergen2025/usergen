generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  LIVE
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum CampaignPayoutModel {
  CPM
  POOL
}

enum FinalizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  APPLIED
  APPROVED
  REJECTED
  SUBMITTED
  WITHDRAWN
}

enum PostSubmissionStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum EarningStatus {
  LOCKED
  AVAILABLE
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum WalletSyncStatus {
  RETRY_PENDING
  FAILED
  SYNCED
}

enum CampaignMediaSourceType {
  PROJECT_LIBRARY
  UPLOAD
  EXTERNAL_URL
}

enum CampaignMediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SsembleRequestStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Campaign {
  id              String         @id @default(cuid())
  brandId         String
  name            String
  description     String
  status          CampaignStatus @default(DRAFT)
  payoutModel     CampaignPayoutModel @default(POOL)
  deadlineToApply DateTime
  startDate       DateTime
  endDate         DateTime
  payoutRate      Decimal?
  totalBudget     Decimal
  budgetUsed      Decimal        @default(0)
  views           Int            @default(0)
  targetViews     Int            @default(0)
  brandAssetsUrl  String?
  campaignType    String         @default("REPOST_CPM")
  industry        String?
  platformTarget  String?
  regionFilter    String?
  prizePoolJson      Json?
  tieBreaker         String   @default("EARLIER_VERIFIED_POST")
  minViewsToQualify  Int      @default(0)
  gracePeriodHours   Int      @default(24)
  previewN           Int      @default(10)
  finalizedAt        DateTime?
  finalizationStatus FinalizationStatus @default(PENDING)
  finalizationError  String?
  finalizationAttempts Int    @default(0)
  exceptionRefundAmountPaise BigInt?
  manualScrapeCooldownSec Int      @default(21600)
  lastManualScrapeAt        DateTime?
  actualStartDate           DateTime?
  actualEndDate             DateTime?
  manuallyStartedBy         String?
  manuallyEndedBy           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  submissions     Submission[]
  applications    CampaignApplication[]
  postSubmissions CampaignPostSubmission[]
  earnings        CampaignEarningSnapshot[]
  creatorEarnings CreatorEarning[]
  mediaAssets     CampaignMediaAsset[]
  leaderboardSnapshots CampaignLeaderboardSnapshot[]
  postScrapeRuns  CampaignPostScrapeRun[]
  sourceVideos    CampaignSourceVideo[]

  @@index([finalizationStatus, status])
  @@index([payoutModel, status])
}

model CampaignMediaAsset {
  id                   String                 @id @default(cuid())
  ownerId              String
  campaignId           String?
  sourceType           CampaignMediaSourceType
  projectId            String?
  originalSourceUrl    String?
  originalLocalPath    String?
  originalGcsUrl       String?
  watermarkedLocalPath String?
  watermarkedGcsUrl    String?
  mimeType             String?
  sizeBytes            Int?
  status               CampaignMediaStatus      @default(PENDING)
  error                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  campaign             Campaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  applicationDraft     CampaignApplication?     @relation("ApplicationDraftMedia")

  @@index([ownerId, createdAt])
  @@index([campaignId])
}

model Submission {
  id          String           @id @default(cuid())
  campaignId  String
  creatorId   String
  creatorName String
  creatorHandle String
  contentUrl  String
  platform    String
  status      SubmissionStatus @default(PENDING)
  views       Int              @default(0)
  earnings    Decimal          @default(0)
  comment     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reviews          SubmissionReview[]
  earningSnapshots CampaignEarningSnapshot[]

  @@index([campaignId])
  @@index([creatorId])
}

model CampaignApplication {
  id         String            @id @default(cuid())
  campaignId String
  creatorId  String
  status     ApplicationStatus @default(APPLIED)
  draftMediaUrl String?
  draftMediaAssetId String?   @unique
  platform   String?
  termsAccepted Boolean        @default(false)
  termsAcceptedAt DateTime?
  reviewedBy String?
  reviewedAt DateTime?
  reviewComment String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  draftMediaAsset CampaignMediaAsset? @relation("ApplicationDraftMedia", fields: [draftMediaAssetId], references: [id], onDelete: SetNull)
  postSubmissions CampaignPostSubmission[]

  @@unique([campaignId, creatorId])
  @@index([creatorId])
}

model CampaignPostSubmission {
  id            String               @id @default(cuid())
  campaignId    String
  creatorId     String
  applicationId String?
  postUrl       String
  platform      String
  status        PostSubmissionStatus @default(PENDING_REVIEW)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewComment String?
  currentViews         Int       @default(0)
  lastViewsUpdatedAt   DateTime?
  disqualifiedAt       DateTime?
  disqualifiedReason   String?
  ownerUsername        String?
  postCreatedAt        DateTime?
  postPlatformId       String?
  caption              String?
  hashtags             Json?
  likesCount           Int       @default(0)
  commentsCount        Int       @default(0)
  prelimCheckedAt      DateTime?
  prelimCheckPassed    Boolean?
  lastScrapeRunId      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  campaign      Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application   CampaignApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  creatorEarnings CreatorEarning[]
  viewUpdates   CampaignPostViewUpdate[]
  scrapeResults CampaignPostScrapeResult[]

  @@index([campaignId, creatorId])
  @@index([status, createdAt])
  @@index([campaignId, currentViews])
}

model CampaignPostViewUpdate {
  id               String   @id @default(cuid())
  postSubmissionId String
  previousViews    Int
  newViews         Int
  recordedBy       String
  recordedAt       DateTime @default(now())
  note             String?
  postSubmission   CampaignPostSubmission @relation(fields: [postSubmissionId], references: [id], onDelete: Cascade)

  @@index([postSubmissionId, recordedAt])
}

model CampaignLeaderboardSnapshot {
  id                  String   @id @default(cuid())
  campaignId          String
  creatorId           String
  postSubmissionId    String?
  hadVerifiedPost     Boolean
  rank                Int?
  views               Int      @default(0)
  percentageBps       Int      @default(0)
  payoutAmountPaise   BigInt   @default(0)
  droppedReason       String?
  finalizationId      String?
  createdAt           DateTime @default(now())
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, rank])
  @@index([campaignId, creatorId])
}

model CreatorEarning {
  id               String        @id @default(cuid())
  campaignId       String
  creatorId        String
  postSubmissionId String?
  viewsDelta       Int           @default(0)
  cpmRate          Decimal?
  amount           Decimal
  status           EarningStatus @default(LOCKED)
  source           String        @default("CPM")
  earnedAt         DateTime      @default(now())
  unlockAt         DateTime
  availableAt      DateTime?
  reversedAt       DateTime?
  lockReason       String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  campaign         Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postSubmission   CampaignPostSubmission? @relation(fields: [postSubmissionId], references: [id], onDelete: SetNull)

  @@index([creatorId, status, unlockAt])
  @@index([campaignId, createdAt])
}

model SubmissionReview {
  id           String           @id @default(cuid())
  submissionId String
  reviewerId   String
  status       SubmissionStatus
  comment      String?
  createdAt    DateTime         @default(now())
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

model CampaignEarningSnapshot {
  id           String     @id @default(cuid())
  campaignId   String
  submissionId String
  creatorId    String
  views        Int        @default(0)
  cpmRate      Decimal
  earnings     Decimal
  createdAt    DateTime   @default(now())
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([creatorId])
}

model WithdrawalRequest {
  id         String           @id @default(cuid())
  creatorId  String
  amount     Decimal
  status     WithdrawalStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([creatorId, status])
}

model WalletSyncEvent {
  id         String           @id @default(cuid())
  eventType  String
  status     WalletSyncStatus @default(RETRY_PENDING)
  attempts   Int              @default(0)
  payload    Json
  lastError  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([eventType])
}

model CampaignPostScrapeRun {
  id                String   @id @default(cuid())
  campaignId        String
  scope             String
  triggeredBy       String
  triggeredById     String?
  status            String
  apifyRunId        String?
  postsRequested    Int      @default(0)
  postsScraped      Int      @default(0)
  postsFailed       Int      @default(0)
  postsDisqualified Int      @default(0)
  startedAt         DateTime @default(now())
  finishedAt        DateTime?
  error             String?
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  results           CampaignPostScrapeResult[]

  @@index([campaignId, startedAt])
  @@index([status, startedAt])
}

model CampaignPostScrapeResult {
  id               String   @id @default(cuid())
  scrapeRunId      String
  postSubmissionId String
  status           String
  apifyShortcode   String?
  apifyPostId      String?
  videoPlayCount   Int?
  videoViewCount   Int?
  likesCount       Int?
  commentsCount    Int?
  postTimestamp    DateTime?
  ownerUsername    String?
  productType      String?
  rawJson          Json?
  errorMessage     String?
  createdAt        DateTime @default(now())
  scrapeRun        CampaignPostScrapeRun  @relation(fields: [scrapeRunId], references: [id], onDelete: Cascade)
  postSubmission   CampaignPostSubmission @relation(fields: [postSubmissionId], references: [id], onDelete: Cascade)

  @@index([scrapeRunId])
  @@index([postSubmissionId, createdAt])
}

model CampaignSourceVideo {
  id            String   @id @default(cuid())
  campaignId    String
  url           String
  urlType       String
  title         String?
  thumbnailUrl  String?
  durationSecs  Int?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipRequests  SsembleClipRequest[]

  @@index([campaignId, orderIndex])
}

model SsembleClipRequest {
  id               String               @id @default(cuid())
  sourceVideoId    String
  creatorId        String
  campaignId       String
  ssembleRequestId String?
  status           SsembleRequestStatus @default(QUEUED)
  progress         Int                  @default(0)
  currentStep      String?
  startSec         Int
  endSec           Int
  preferredLength  String               @default("under60sec")
  language         String               @default("en")
  captionLanguage  String?
  templateId       String?
  hookTitle        Boolean              @default(false)
  memeHook         Boolean              @default(false)
  memeHookName     String?
  gameVideo        Boolean              @default(false)
  gameVideoName    String?
  ctaEnabled       Boolean              @default(false)
  ctaText          String?
  music            Boolean              @default(false)
  musicName        String?
  musicVolume      Int                  @default(10)
  layout           String               @default("auto")
  errorMessage     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sourceVideo      CampaignSourceVideo  @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  clips            SsembleClip[]

  @@index([creatorId, campaignId])
  @@index([ssembleRequestId])
  @@index([status, createdAt])
}

model SsembleClip {
  id             String             @id @default(cuid())
  requestId      String
  ssembleClipId  String
  title          String?
  description    String?
  videoUrl       String
  thumbnailUrl   String?
  durationSecs   Int?
  viralScore     Float?
  createdAt      DateTime           @default(now())
  request        SsembleClipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, viralScore])
}
