# Environment Configuration for Workspace Service
NODE_ENV=local
SERVICE_NAME=workspace-service
SERVICE_PORT=9007
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_workspaces

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Message Queue Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Auth Service URL (for user validation)
AUTH_SERVICE_URL=http://localhost:9000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:9000,http://localhost:9007

# Monitoring Configuration
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9091


