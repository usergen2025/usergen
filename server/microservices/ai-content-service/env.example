# Environment Configuration for AI Content Service
NODE_ENV=local
SERVICE_NAME=ai-content-service
SERVICE_PORT=9001
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/usergen_ai_content

# Redis Configuration
REDIS_URL=redis://localhost:6379

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/usergen_ai_metadata

# Message Queue Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# FAL API (avatar preview multi-reference image generation)
FAL_KEY=your-fal-api-key-here

# AI Service API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_GPT4=gpt-4o
OPENAI_MODEL_GPT35=gpt-3.5-turbo
# Responses API + web_search_preview (script factual pre-step)
OPENAI_MODEL_WEB_SEARCH=gpt-4o
# Script web search: auto (keyword detect) | always | off
SCRIPT_WEB_SEARCH_ENABLED=true
SCRIPT_WEB_SEARCH_MODE=auto
SCRIPT_WEB_SEARCH_ON_URL_ASSET=true
SCRIPT_WEB_SEARCH_TIMEOUT_MS=45000
SCRIPT_TEMPERATURE_FACTUAL=0.3
# AI text avatar: indian | off | auto (auto = only when language is hindi/hinglish)
DEFAULT_AVATAR_ETHNICITY=indian
# Avatar intent classification: on | off (default: on)
AVATAR_INTENT_CLASSIFICATION_ENABLED=on
# Model for avatar intent classification (cost-efficient)
AVATAR_INTENT_CLASSIFICATION_MODEL=gpt-4o-mini
# Fallback when classification fails: human | passthrough
AVATAR_INTENT_CLASSIFICATION_FALLBACK=human
OPENAI_MODEL_DALLE3=dall-e-3
OPENAI_MODEL_DALLE2=dall-e-2

# Midjourney API Configuration
MIDJOURNEY_API_KEY=your-midjourney-api-key-here
MIDJOURNEY_BASE_URL=https://api.midjourney.com/v1

# Runway API Configuration
RUNWAY_API_KEY=your-runway-api-key-here
RUNWAY_BASE_URL=https://api.runwayml.com/v1

# AI Service Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT=30000
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY=1000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=50

# CORS Configuration
CORS_ORIGINS=http://localhost:3200,http://localhost:9000,http://localhost:9001

# Storage / uploads (dual local + GCS paths for logo brand pipeline)
BACKEND_BASE_URL=http://localhost:9001
UPLOADS_DIR=./uploads
VIDEO_PROCESSING_SERVICE_URL=http://localhost:9004

# HeyGen API Configuration
HEYGEN_API_KEY=sk_V2_hgu_k6DttD76w1e_AacvV2PfTOzCaxk1morlTbR2FX5YvmQp

# Monitoring Configuration
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9091

# GCS (Google Cloud Storage) Configuration
# Enable GCS for public URL generation (replaces FAL storage)
GCS_ENABLED=false
GCS_BUCKET_NAME=usergen-storage
GCS_PROJECT_ID=your-gcp-project-id
#
# Authentication Options (in order of preference):
# 1. ADC (Application Default Credentials) - RECOMMENDED
#    - For local dev: Run "gcloud auth application-default login"
#    - For GCP environments: Works automatically
#    - Leave GOOGLE_APPLICATION_CREDENTIALS and GCS_CREDENTIALS_JSON_BASE64 unset
#
# 2. Service Account Key File (if ADC not available):
#    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# 3. Base64-encoded credentials (for containerized deployments):
#    GCS_CREDENTIALS_JSON_BASE64=eyJ...
