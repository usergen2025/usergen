# =============================================================================
# Next.js public env (exposed to the browser). Restart dev server after changes.
# Copy to .env.local and adjust ports/hosts if your stack differs.
# =============================================================================

# --- Core API (often points at auth or Kong) ---
# Via Kong: http://localhost:8000/api | Direct auth: http://localhost:9000/api
NEXT_PUBLIC_API_URL=http://localhost:9000/api

# Auth service (login, admin APIs, user profile). Browser hits e.g. .../api/auth/google
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:9000/api

# Environment label: local | development | production
NEXT_PUBLIC_ENV=local

# --- Admin IAM & billing (browser calls these directly) ---
# Identity & Access Management (roles, permissions, audit logs)
NEXT_PUBLIC_IAM_SERVICE_URL=http://localhost:9010/api

# Payment / credits ledger (balance, transactions)
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:9005/api

# --- Feature services (defaults match Nest microservice ports + /api) ---
NEXT_PUBLIC_VIDEO_SERVICE_URL=http://localhost:9004/api
NEXT_PUBLIC_AI_CONTENT_SERVICE_URL=http://localhost:9001/api
NEXT_PUBLIC_VOICE_SERVICE_URL=http://localhost:9002/api

# WebSocket / realtime (video job status; often same host as video service)
NEXT_PUBLIC_WS_URL=http://localhost:9004

# Media / stock assets API base (no /api suffix where routes expect host root)
NEXT_PUBLIC_MEDIA_SERVICE_URL=http://localhost:9009

# Campaign service (if enabled)
NEXT_PUBLIC_CAMPAIGN_SERVICE_URL=http://localhost:9011/api
