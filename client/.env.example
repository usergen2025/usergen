# Copy to .env or .env.local for local development (both are gitignored except this file).
#
#   cp .env.example .env
#   cp .env.example .env.local
#
# Restart Next.js after changes: cd client && npm run dev

# --- Required for auth / AI Chat (fixes "Network error: No response from server") ---
# apiClient uses NEXT_PUBLIC_API_URL for login, register, getProfile — NOT AUTH_SERVICE_URL alone.
NEXT_PUBLIC_API_URL=http://localhost:9000/api
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:9000/api

# --- Video create / workspace / download proxies ---
NEXT_PUBLIC_VIDEO_SERVICE_URL=http://localhost:9004/api
# Base origin for /uploads URLs and WebSocket (no /api suffix)
NEXT_PUBLIC_WS_URL=http://localhost:9004

# --- AI content (scripts, avatars, asset uploads) ---
NEXT_PUBLIC_AI_CONTENT_SERVICE_URL=http://localhost:9001/api

# --- Voice audio ---
NEXT_PUBLIC_VOICE_SERVICE_URL=http://localhost:9002/api

# --- Optional microservices (defaults match npm run dev in server/) ---
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:9005/api
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:9006/api
NEXT_PUBLIC_MEDIA_SERVICE_URL=http://localhost:9009/api
NEXT_PUBLIC_IAM_SERVICE_URL=http://localhost:9010/api
NEXT_PUBLIC_CAMPAIGN_SERVICE_URL=http://localhost:9011/api

# --- Production example (uncomment and adjust) ---
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_VIDEO_SERVICE_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_WS_URL=https://api.yourdomain.com
